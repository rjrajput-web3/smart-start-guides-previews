# ============================================================================
# Marketplace Starter — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ============================================================================

# --- App ------------------------------------------------------------------
# Public URL of the app. Used by NextAuth for callback URLs.
# Local dev: http://localhost:3000  |  Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# Secret used to sign NextAuth JWTs / encrypt session cookies.
# REQUIRED in production. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-32-char-secret

# --- Database ---------------------------------------------------------------
# Prisma connection string. Default below is a local SQLite file (zero setup,
# no server needed) — good for local development and demos.
# For production use PostgreSQL, e.g.:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/marketplace?schema=public"
DATABASE_URL="file:./dev.db"

# --- OAuth: Google (optional) ----------------------------------------------
# Enable "Sign in with Google" by creating OAuth credentials at
# https://console.cloud.google.com/apis/credentials (free, no KYC).
# Leave both blank to disable the Google button; email/password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub (optional) ----------------------------------------------
# Enable "Sign in with GitHub" at https://github.com/settings/developers
# (OAuth Apps > New OAuth App). Leave blank to disable the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (optional, password-reset / order mail) --------------------------
# SMTP server for NextAuth email flows. Leave blank to disable email sending;
# the app runs fine without it. Example for Gmail app-password SMTP:
#   EMAIL_SERVER=smtp://user:app-password@smtp.gmail.com:587
#   EMAIL_FROM="Marketplace <noreply@example.com>"
EMAIL_SERVER=
EMAIL_FROM=
